{
  "model": "qwen-image-2.1",
  "data": "images/",
  "seed": 42,
  "steps": 20,
  "quantize": null,
  "max_resolution": 512,
  "low_ram": false,
  "gradient_checkpointing": true,
  "cache_limit_gb": 2,
  "training_loop": {
    "num_epochs": 25,
    "batch_size": 1
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.0001,
    "optimizer_params": {
      "eps": 1e-06,
      "weight_decay": 0.01
    },
    "max_grad_norm": 1.0
  },
  "checkpoint": {
    "save_frequency": 100,
    "output_path": "train_qwen_image_21"
  },
  "monitoring": {
    "preview_width": 512,
    "preview_height": 512,
    "plot_frequency": 50,
    "generate_image_frequency": 100
  },
  "lora_layers": {
    "targets": [
      {
        "module_path": "transformer_blocks.{block}.attn.to_q",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.attn.to_k",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.attn.to_v",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.attn.to_out.0",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.img_mlp.gate_layer",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.img_mlp.proj",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      },
      {
        "module_path": "transformer_blocks.{block}.img_mlp.out",
        "blocks": {
          "start": 0,
          "end": 32
        },
        "rank": 16,
        "alpha": 16
      }
    ]
  }
}
